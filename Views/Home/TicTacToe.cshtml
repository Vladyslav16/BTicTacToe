@{
    ViewData["Title"] = "Tic Tac Toe";
}

<h2>Гра Хрестики-Нолики</h2>
<link rel="stylesheet" href="~/css/tictactoe.css" />


<div id="game">
    <table>
        @for (int i = 0; i < 3; i++)
        {
            <tr>
                @for (int j = 0; j < 3; j++)
                {
                    <td>
                        <button onclick="makeMove(@i, @j)" id="cell-@i-@j" style="width: 60px; height: 60px; font-size: 24px;"></button>
                    </td>
                }
            </tr>
        }
    </table>
    <p id="status" style="margin-top: 10px;"></p>
    <p id="score">Рахунок — X: 0 | O: 0</p>
    <div style="margin-top: 10px">
        <label for="difficulty">Складність:</label>
        <select id="difficulty">
            <option value="easy">Легкий</option>
            <option value="medium">Середній</option>
            <option value="hard" selected>Високий</option>
        </select>
    </div>
    <button onclick="resetGame()">Нова гра</button>
    <button onclick="changeSymbol()">Змінити символ (зараз: <span id="symbol">X</span>)</button>
</div>

@section Scripts {
    <script src="~/js/tictactoe-bots.js"></script>
}
